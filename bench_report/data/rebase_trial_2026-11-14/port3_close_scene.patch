+void VoxelHashMap::refresh_normal(const Voxel& voxel, const VoxelBlock& block) {
+  constexpr unsigned int min_normal_points = 5;
+  constexpr double planarity_ratio = 3.0;
+  constexpr double min_mid_to_major_ratio = 0.05;
+  if (block.size < min_normal_points) {
+    return;
+  }
+  // in quanta from the voxel centre: the normal's direction does not depend on the unit
+  Eigen::Vector3d mean = Eigen::Vector3d::Zero();
+  for (const Eigen::Vector3i8& offset : block) {
+    mean += offset.cast<double>();
+  }
+  mean /= static_cast<double>(block.size);
+  Eigen::Matrix3d covariance = Eigen::Matrix3d::Zero();
+  for (const Eigen::Vector3i8& offset : block) {
+    const Eigen::Vector3d d = offset.cast<double>() - mean;
+    covariance += d * d.transpose();
+  }
+  covariance /= static_cast<double>(block.size);
+  const Eigen::SelfAdjointEigenSolver<Eigen::Matrix3d> solver(covariance);
+  const Eigen::Vector3d& eigenvalues = solver.eigenvalues(); // ascending
+  if (eigenvalues(1) < planarity_ratio * eigenvalues(0) || eigenvalues(1) < min_mid_to_major_ratio * eigenvalues(2)) {
+    normal_map_.erase(voxel); // a line or a blob: no trustworthy normal
+    return;
+  }
+  normal_map_.insert_or_assign(voxel, solver.eigenvectors().col(0).cast<Scalar>());
+}
+
+std::optional<Eigen::Vector3s> VoxelHashMap::voxel_normal(const Eigen::Vector3s& point) const {
+  const auto search = normal_map_.find(point_to_voxel(point, inv_voxel_size_));
+  if (search == normal_map_.end()) {
+    return std::nullopt;
+  }
+  return search->second;
+}
+
 void VoxelHashMap::remove_points_far_from_location(const Eigen::Vector3s& location) {
   // a centre is within half a diagonal of every point it holds, so widening by that keeps a superset
   const Scalar half_diagonal = static_cast<Scalar>(0.5) * std::numbers::sqrt3_v<Scalar> * voxel_size;
   const Scalar max_distance_sq = square(clipping_distance_ + half_diagonal);
   for (auto it = voxels.begin(); it != voxels.end();) {
-    it = (center_of_voxel(it->first) - location).squaredNorm() > max_distance_sq ? voxels.erase(it) : std::next(it);
+    if ((center_of_voxel(it->first) - location).squaredNorm() > max_distance_sq) {
+      normal_map_.erase(it->first);
+      it = voxels.erase(it);
+    } else {
+      ++it;
+    }
   }
 }
 
