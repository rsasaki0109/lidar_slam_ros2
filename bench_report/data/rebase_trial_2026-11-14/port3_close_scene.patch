 using LinearSystem = std::tuple<Eigen::Matrix6s, Eigen::Vector6s, Scalar>;
+// Port of the fork's localizability weighting (close-scene settings): the travel direction in the world frame, the
+// boost, and whether only the residual along the map normal is boosted.
+struct CloseSceneWeighting {
+  Eigen::Vector3s axis;
+  Scalar boost;
+  bool normal_only;
+};
+
 LinearSystem build_icp_linear_system(const Sophus::SE3s& current_pose,
                                      const rko_lio::core::Vector3sVector& keypoints,
                                      const rko_lio::core::VoxelHashMap& voxel_map,
-                                     const Scalar& max_correspondence_distance) {
-  using IcpAccum = std::tuple<Eigen::Matrix6s, Eigen::Vector6s, Scalar, int>;
+                                     const Scalar& max_correspondence_distance,
+                                     const std::optional<CloseSceneWeighting>& weighting = std::nullopt) {
+  // the last entry is the weight sum; without weighting every weight is 1 and it is the correspondence count
+  using IcpAccum = std::tuple<Eigen::Matrix6s, Eigen::Vector6s, Scalar, Scalar>;
 
-  auto linear_system_for_one_point = [](const Eigen::Vector3s& source, const Eigen::Vector3s& residual) {
+  const Eigen::Matrix3s rotation_transpose = current_pose.so3().inverse().matrix();
+
+  auto linear_system_for_one_point = [&](const Eigen::Vector3s& source, const Eigen::Vector3s& residual,
+                                         const Eigen::Vector3s& target) {
     // world frame this is R * [I | -hat(source)]; write the residual in the body frame, the R cancels, and the compute
     // is cheaper
     Eigen::Matrix3_6s J_r;
     J_r.block<3, 3>(0, 0) = Eigen::Matrix3s::Identity();
     J_r.block<3, 3>(0, 3) = -1.0 * Sophus::SO3s::hat(source);
+    if (weighting.has_value()) {
+      const std::optional<Eigen::Vector3s> normal = voxel_map.voxel_normal(target);
+      if (normal.has_value()) {
+        const Scalar cosine = normal->dot(weighting->axis);
+        const Scalar weight = 1 + weighting->boost * cosine * cosine;
+        if (weight > 1) {
+          if (weighting->normal_only) {
+            // W = I + (weight - 1) n n^T, with the normal in the body frame like the residual
+            const Eigen::Vector3s n = rotation_transpose * *normal;
+            const Eigen::Matrix3s W = Eigen::Matrix3s::Identity() + (weight - 1) * n * n.transpose();
+            return IcpAccum(J_r.transpose() * W * J_r, J_r.transpose() * W * residual, residual.dot(W * residual),
+                            1 + (weight - 1) / 3);
+          }
+          return IcpAccum(weight * J_r.transpose() * J_r, weight * J_r.transpose() * residual,
+                          weight * residual.squaredNorm(), weight);
+        }
+      }
+    }
     return IcpAccum(J_r.transpose() * J_r,      // JTJ
                     J_r.transpose() * residual, // JTr
                     residual.squaredNorm(),     // chi
                     1);                         // correspondence
   };
 
-  const Eigen::Matrix3s rotation_transpose = current_pose.so3().inverse().matrix();
-
   // The only parallel part
   using points_iterator = std::vector<Eigen::Vector3s>::const_iterator;
   const auto& [H_icp, b_icp, chi_icp, correspondences_counter] = tbb::parallel_reduce(
       // Range
       tbb::blocked_range<points_iterator>{keypoints.cbegin(), keypoints.cend()},
       // Identity
-      IcpAccum(Eigen::Matrix6s::Zero(), Eigen::Vector6s::Zero(), 0.0, 0),
+      IcpAccum(Eigen::Matrix6s::Zero(), Eigen::Vector6s::Zero(), 0.0, 0.0),
       // 1st Lambda: Parallel computation
       [&](const tbb::blocked_range<points_iterator>& r, IcpAccum J) -> IcpAccum {
         auto& [H, b, chi, correspondences] = J;
@@ -151,7 +180,8 @@ LinearSystem build_icp_linear_system(const Sophus::SE3s& current_pose,
             continue;
           }
           const Eigen::Vector3s residual = rotation_transpose * (transformed_point - *closest_neighbor);
-          const auto& [point_H, point_b, point_chi, point_n] = linear_system_for_one_point(point, residual);
+          const auto& [point_H, point_b, point_chi, point_n] =
+              linear_system_for_one_point(point, residual, *closest_neighbor);
           H += point_H;
           b += point_b;
           chi += point_chi;
@@ -194,7 +224,9 @@ Sophus::SE3s icp(const Vector3sVector& keypoints,
                  const VoxelHashMap& voxel_map,
                  const Sophus::SE3s& initial_guess,
