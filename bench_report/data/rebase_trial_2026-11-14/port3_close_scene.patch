   const Scalar beta = (config.min_beta > 0 && optional_accel_info.has_value())
                           ? (config.min_beta * (1 + optional_accel_info->accel_mag_variance))
@@ -206,7 +238,7 @@ Sophus::SE3s icp(const Vector3sVector& keypoints,
   for (size_t i = 0; i < config.max_iterations; ++i) {
     const auto& [H, b, chi] = std::invoke([&]() -> LinearSystem {
       const auto& [H_icp, b_icp, chi_icp] =
-          build_icp_linear_system(current_pose, keypoints, voxel_map, config.max_correspondence_distance);
+          build_icp_linear_system(current_pose, keypoints, voxel_map, max_correspondence_distance, weighting);
       if (beta >= 0) {
         const auto& [H_ori, b_ori, chi_ori] =
             build_orientation_linear_system(current_pose, optional_accel_info->local_gravity_estimate);
@@ -251,7 +283,9 @@ namespace rko_lio::core {
 LIO::LIO(const Config& config_)
     : config(config_),
       map(config_.voxel_size, config_.max_range),
-      arena(config_.max_num_threads > 0 ? config_.max_num_threads : tbb::task_arena::automatic) {}
+      arena(config_.max_num_threads > 0 ? config_.max_num_threads : tbb::task_arena::automatic) {
+  map.set_maintain_normals(config.close_scene_max_median_range > 0 && config.close_scene_localizability_boost > 0);
+}
 
 // ==========================
 //          private
@@ -479,8 +513,50 @@ Vector3sVector LIO::register_scan(Vector3sVector scan, const Timestamps& timesta
 
   if (!map.empty()) {
     SCOPED_PROFILER("ICP");
-    const Sophus::SE3s optimized_pose =
-        arena.execute([&] { return icp(preproc_result.keypoints, map, initial_guess, config, kf_step.info); });
+    // Port of the fork's close-scene settings (see Config)
+    bool close_scene = false;
+    if (config.close_scene_max_median_range > 0) {
+      std::vector<Scalar> ranges(preproc_result.keypoints.size());
+      std::transform(preproc_result.keypoints.cbegin(), preproc_result.keypoints.cend(), ranges.begin(),
+                     [](const Eigen::Vector3s& point) { return point.norm(); });
+      const auto middle = ranges.begin() + static_cast<std::ptrdiff_t>(ranges.size() / 2);
+      std::nth_element(ranges.begin(), middle, ranges.end());
+      close_scene = *middle < config.close_scene_max_median_range;
+    }
+    const Scalar scan_distance = close_scene && config.close_scene_max_correspondence_distance > 0
+                                     ? config.close_scene_max_correspondence_distance
+                                     : config.max_correspondence_distance;
+    std::optional<CloseSceneWeighting> weighting;
+    if (close_scene && config.close_scene_localizability_boost > 0) {
+      const Eigen::Vector3s step = initial_guess.translation() - lidar_state.pose.translation();
+      if (step.norm() >= config.localizability_min_step_m) {
+        weighting = CloseSceneWeighting{.axis = step.normalized(),
+                                        .boost = config.close_scene_localizability_boost,
+                                        .normal_only = config.close_scene_localizability_normal_only};
+      }
+    }
+    const Sophus::SE3s optimized_pose = arena.execute([&] {
+      Sophus::SE3s pose = icp(preproc_result.keypoints, map, initial_guess, config, kf_step.info, scan_distance, weighting);
+      if (close_scene && config.close_scene_min_inlier_fraction > 0) {
+        const std::size_t inliers = static_cast<std::size_t>(
+            std::count_if(preproc_result.keypoints.cbegin(), preproc_result.keypoints.cend(),
+                          [&](const Eigen::Vector3s& point) {
+                            return map.get_closest_neighbor(pose * point, scan_distance).has_value();
+                          }));
+        if (static_cast<Scalar>(inliers) / static_cast<Scalar>(preproc_result.keypoints.size()) <
+            config.close_scene_min_inlier_fraction) {
+          // coarse with the base settings, then fine with the close-scene settings from there
+          ++close_scene_fallback_count;
+          const Sophus::SE3s coarse = icp(preproc_result.keypoints, map, initial_guess, config, kf_step.info,
+                                          config.max_correspondence_distance);
+          pose = icp(preproc_result.keypoints, map, coarse, config, kf_step.info, scan_distance, weighting);
+        }
+      }
+      return pose;
+    });
+    if (close_scene) {
+      ++close_scene_scan_count;
+    }
 
     // estimate velocities and accelerations from the new pose
     const auto dt = to_seconds<Scalar>(current_lidar_time - lidar_state.time);
