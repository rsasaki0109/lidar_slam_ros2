+     *  the keypoints end within the correspondence distance, the scan is registered again, first with the base
+     *  settings, then with the close-scene ones from there. */
+    Scalar close_scene_max_median_range = 0.0;
+    Scalar close_scene_max_correspondence_distance = 0.0;
+    Scalar close_scene_localizability_boost = 0.0;
+    bool close_scene_localizability_normal_only = false;
+    Scalar close_scene_min_inlier_fraction = 0.0;
+    Scalar localizability_min_step_m = 0.05;
+
     /** Minimum weight for orientation regularization. */
     Scalar min_beta = 200;
   };
@@ -109,6 +122,9 @@ public:
 
