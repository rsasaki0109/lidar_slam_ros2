<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidarslam_default_plugins</name>
  <version>0.6.0</version>
  <description>Built-in registration plugins for lidar_slam_ros2.</description>
  <maintainer email="rsasaki0109@gmail.com">sasaki</maintainer>
  <license>BSD-2-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>pluginlib</depend>
  <depend>lidarslam_plugin_interfaces</depend>
  <depend>ndt_omp_ros2</depend>

  <!-- Optional build-time dependency.  FAST adapters and their plugin
       manifest are exported only when fast_gicp is found; this package must
       remain usable on dependency-absent hosts. -->

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
