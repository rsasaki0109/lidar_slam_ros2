{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/canonical-ndt-convergence-readiness-v1.schema.json",
  "title": "Canonical ndt_omp convergence readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "contract_id",
    "mode",
    "status",
    "checks",
    "upstream_checkout",
    "candidate_checkout",
    "publication_preflight",
    "actions",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_uri": {
      "const": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/canonical-ndt-convergence-readiness-v1.schema.json"
    },
    "contract_id": {"const": "canonical-ndt-convergence-20260812"},
    "mode": {
      "enum": ["artifacts", "upstream-checkout", "draft-preflight"]
    },
    "status": {
      "enum": [
        "ARTIFACTS_READY",
        "READY_FOR_UPSTREAM_REVIEW",
        "READY_FOR_DRAFT_PR",
        "BLOCKED"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/check"}
    },
    "upstream_checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspected", "commit", "clean", "patch_applies"],
      "properties": {
        "inspected": {"type": "boolean"},
        "commit": {"type": ["string", "null"]},
        "clean": {"type": ["boolean", "null"]},
        "patch_applies": {"type": ["boolean", "null"]}
      }
    },
    "candidate_checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspected",
        "commit",
        "parent_commit",
        "clean",
        "subject",
        "patch_matches"
      ],
      "properties": {
        "inspected": {"type": "boolean"},
        "commit": {"type": ["string", "null"]},
        "parent_commit": {"type": ["string", "null"]},
        "clean": {"type": ["boolean", "null"]},
        "subject": {"type": ["string", "null"]},
        "patch_matches": {"type": ["boolean", "null"]}
      }
    },
    "publication_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspected",
        "upstream_repository",
        "fork_repository",
        "proposed_branch",
        "errors",
        "upstream_head_sha",
        "fork_is_expected",
        "proposed_branch_present",
        "open_pr_count",
        "duplicate_prs"
      ],
      "properties": {
        "inspected": {"type": "boolean"},
        "upstream_repository": {"const": "koide3/ndt_omp"},
        "fork_repository": {"const": "rsasaki0109/ndt_omp_ros2"},
        "proposed_branch": {
          "const": "lidarslam-priors-and-correspondence-diagnostics"
        },
        "errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "upstream_head_sha": {"type": ["string", "null"]},
        "fork_is_expected": {"type": ["boolean", "null"]},
        "proposed_branch_present": {"type": ["boolean", "null"]},
        "open_pr_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "duplicate_prs": {
          "type": "array",
          "items": {"$ref": "#/definitions/duplicate_pr"}
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_writes_authorized", "remote_mutations_performed"],
      "properties": {
        "github_writes_authorized": {"const": false},
        "remote_mutations_performed": {"const": false}
      }
    }
  },
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "detail"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "NOT_CHECKED"]},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "duplicate_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "url", "head_label", "head_sha"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "head_label": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "minLength": 1}
      }
    }
  }
}
