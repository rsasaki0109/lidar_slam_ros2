{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/bounded-filesystem-exhaustion-v1.schema.json",
  "title": "lidarslam_ros2 bounded filesystem exhaustion report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "started_at",
    "finished_at",
    "duration_sec",
    "hardware_label",
    "image",
    "harness",
    "input",
    "bounded_filesystem",
    "execution",
    "observed",
    "checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_uri": {
      "const": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/bounded-filesystem-exhaustion-v1.schema.json"
    },
    "status": {"enum": ["passed", "failed"]},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "duration_sec": {"type": "number", "minimum": 0},
    "hardware_label": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "image_id",
        "repo_digests",
        "source_revision",
        "runtime_overlay_revision",
        "runtime_overlay_payload_sha256"
      ],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "image_id": {"type": "string", "minLength": 1},
        "repo_digests": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_revision": {"type": "string"},
        "runtime_overlay_revision": {"type": "string"},
        "runtime_overlay_payload_sha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty",
        "script_sha256",
        "runtime_payload"
      ],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "sha256"],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bag_name",
        "metadata_sha256",
        "storage_identifier",
        "message_count",
        "storage_files"
      ],
      "properties": {
        "bag_name": {"type": "string", "minLength": 1},
        "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "storage_identifier": {"type": "string", "minLength": 1},
        "message_count": {"type": "integer", "minimum": 1},
        "storage_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "size_bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "bounded_filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "limit_bytes", "mount_path"],
      "properties": {
        "type": {"const": "docker_tmpfs"},
        "limit_bytes": {"type": "integer", "minimum": 1048576},
        "mount_path": {"const": "/bounded-output"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_exit_code",
        "timed_out",
        "timeout_secs",
        "container_log_sha256"
      ],
      "properties": {
        "container_exit_code": {"type": "integer"},
        "timed_out": {"type": "boolean"},
        "timeout_secs": {"type": "integer", "minimum": 1},
        "container_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observed": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "observed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "observed": {"type": "string"}
        }
      }
    }
  }
}
